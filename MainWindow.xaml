<Window x:Class="TodoApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TodoApp"
        xmlns:svc="clr-namespace:TodoApp.Services"
        xmlns:views="clr-namespace:TodoApp.Views"
        Title="JeffBox"
        Width="620" Height="680"
        MinWidth="440" MinHeight="520"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        Icon="/app.ico"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseDown="Window_PreviewMouseDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="-1"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:LevelIndentConverter x:Key="LevelIndent" />
        <local:LevelScaleConverter x:Key="LevelScale" />
        <local:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <local:TagCountToVisConverter x:Key="TagCountVis" />
        <local:PriorityEqualsConverter x:Key="PriorityEquals" />

        <!-- ============ 滚动条（极简细条） ============ -->
        

        

        <!-- ============ 待办卡片 ============ -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Card}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270"
                                      Opacity="0.10" Color="#3A4160" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter Property="Opacity" Value="0.62" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270"
                                              Opacity="0.05" Color="#3A4160" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ============ 圆形勾选框（带动画） ============ -->
        <Style x:Key="TodoCheck" TargetType="CheckBox">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="34" Height="34" Background="Transparent">
                            <Ellipse x:Name="Ring" Width="21" Height="21"
                                     Stroke="{DynamicResource TrackOff}" StrokeThickness="1.6" />
                            <Ellipse x:Name="Fill" Width="21" Height="21"
                                     Fill="{DynamicResource Accent}" Opacity="0" />
                            <Path x:Name="Check" Data="M 12.25,17.05 L 15.95,20.65 L 21.75,13.35"
                                  Stroke="White" StrokeThickness="2.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Fill"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="Check"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Fill"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="Check"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.10" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 小号勾选框（浮层子级快编行） ============ -->
        <Style x:Key="MiniCheck" TargetType="CheckBox" BasedOn="{StaticResource TodoCheck}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="24" Height="24" Background="Transparent">
                            <Ellipse x:Name="Ring" Width="14" Height="14"
                                     Stroke="{DynamicResource TrackOff}" StrokeThickness="1.4" />
                            <Ellipse x:Name="Fill" Width="14" Height="14"
                                     Fill="{DynamicResource Accent}" Opacity="0" />
                            <Path x:Name="Check" Data="M 4.3,7.4 L 6.7,9.8 L 10.6,5"
                                  Stroke="White" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Fill"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.13" />
                                            <DoubleAnimation Storyboard.TargetName="Check"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Fill"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.10" />
                                            <DoubleAnimation Storyboard.TargetName="Check"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 卡片内文字 ============ -->
        <Style x:Key="CardText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBody}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Padding" Value="0,5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
                    <Setter Property="TextDecorations" Value="Strikethrough" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ============ 删除按钮（悬停卡片时出现） ============ -->
        <Style x:Key="DeleteBtn" TargetType="Button">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DangerBg}" />
                                <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ============ 卡片右侧「›」：展开子任务 / 打开详情 ============ -->
        <Style x:Key="ChevronBtn" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <RotateTransform Angle="90" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ============ 分段按钮（筛选 / 设置选择） ============ -->
        

        <!-- ============ 主输入框 ============ -->
        <Style x:Key="MainInput" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1.4" />
            <Setter Property="Foreground" Value="{DynamicResource TextBody}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="0"
                                                          Opacity="0.20" Color="#5B7CFF" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 添加 / 完成按钮（主色） ============ -->
        

        <!-- ============ 工具栏小按钮 ============ -->
        

        <!-- ============ 优先级选择按钮 ============ -->
        <Style x:Key="PriorityBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Pill}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSub}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="9" Padding="10,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 标题栏按钮 ============ -->
        <Style x:Key="CaptionBtn" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Foreground" Value="{DynamicResource TextSub}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource CaptionBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 文字按钮 ============ -->
        

        <!-- ============ 进度条 ============ -->
        <Style x:Key="SlimProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="5" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="Background" Value="{DynamicResource HoverBg}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="2.5" />
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                    CornerRadius="2.5" HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 开关 ============ -->
        <Style x:Key="SwitchCheck" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="40" Height="22" Background="Transparent">
                            <Border x:Name="Track" CornerRadius="11" Background="{DynamicResource TrackOff}" />
                            <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.25" Color="#3A4160" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ThicknessAnimation Storyboard.TargetName="Knob"
                                                                Storyboard.TargetProperty="Margin"
                                                                To="21,0,0,0" Duration="0:0:0.16">
                                                <ThicknessAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </ThicknessAnimation.EasingFunction>
                                            </ThicknessAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ThicknessAnimation Storyboard.TargetName="Knob"
                                                                Storyboard.TargetProperty="Margin"
                                                                To="3,0,0,0" Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 浮层内控件 ============ -->
        

        <Style x:Key="OverlayTitleBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="Transparent" Padding="0,2">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NotesBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Surface2}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1.4" />
            <Setter Property="Foreground" Value="{DynamicResource TextBody}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinHeight" Value="86" />
            <!-- 高度上限（若有）必须由使用处显式给；基础样式不限高，内容全部展开，
                 溢出交给外层浮层滚动，避免输入框内部滚动吞滚轮 -->
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9" Padding="{TemplateBinding Padding}">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InlineDetailBox" TargetType="TextBox" BasedOn="{StaticResource NotesBox}">
            <!-- 粘贴图片与列表内嵌详情框共用：发件人即 TextBox，附件按所属任务归档 -->
            <EventSetter Event="DataObject.Pasting" Handler="OnNotesPaste" />
        </Style>

        <!-- 创建时的内联详情输入：随内容增长（外层创建卡自身可滚动） -->
        <Style x:Key="NewDetailsBox" TargetType="TextBox" BasedOn="{StaticResource NotesBox}">
            <Setter Property="MinHeight" Value="72" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>

        <!-- 子任务添加输入框 -->

        <!-- 子任务行内文字编辑框 -->
        <Style x:Key="InlineSubBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBody}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
            <Setter Property="Padding" Value="2,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



        <!-- ============ 待办卡片模板（递归：子任务复用同一模板） ============ -->
        <DataTemplate x:Key="TodoCard" DataType="{x:Type local:TodoViewModel}">
            <Border x:Name="CardRoot" Style="{StaticResource CardStyle}" Cursor="Hand"
                    Margin="{Binding Level, Converter={StaticResource LevelIndent}}"
                    MouseEnter="Card_MouseEnter" MouseLeave="Card_MouseLeave"
                    MouseLeftButtonUp="Card_Click">
                <Border.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding Level, Converter={StaticResource LevelScale}}"
                                    ScaleY="{Binding Level, Converter={StaticResource LevelScale}}" />
                </Border.LayoutTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 优先级色条 -->
                        <Rectangle Grid.Column="0" Width="4" RadiusX="2" RadiusY="2"
                                   VerticalAlignment="Stretch" Margin="2,6,10,6">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Priority}" Value="1">
                                            <Setter Property="Fill" Value="#3DD598" />
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Priority}" Value="2">
                                            <Setter Property="Fill" Value="#FFB627" />
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Priority}" Value="3">
                                            <Setter Property="Fill" Value="#FF5A5F" />
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>

                        <CheckBox Grid.Column="1" Style="{StaticResource TodoCheck}"
                                  IsChecked="{Binding IsDone}" />

                        <StackPanel Grid.Column="2" Margin="6,0,8,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardText}" Text="{Binding Text}" />
                        </StackPanel>

                        <!-- 标签（行末，垂直居中） -->
                        <ItemsControl Grid.Column="3" ItemsSource="{Binding Tags}"
                                      VerticalAlignment="Center" Margin="0,0,8,0" IsHitTestVisible="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Pill}" CornerRadius="4"
                                            Padding="5,2" Margin="0,0,4,0">
                                        <TextBlock Text="{Binding}" FontSize="10"
                                                   Foreground="{DynamicResource TextSub}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Grid.Column="4" Style="{StaticResource ChevronBtn}" VerticalAlignment="Center"
                                Click="ChevronBtn_Click" ToolTip="{Binding ChevronTip}">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE76C;" FontSize="11" />
                        </Button>

                        <Button Grid.Column="5" Style="{StaticResource DeleteBtn}" VerticalAlignment="Center"
                                Content="✕" Click="DeleteBtn_Click"
                                ToolTip="{Binding [Delete], Source={x:Static svc:Loc.Instance}}" />

                        <!-- 悬停 500ms 预览弹窗（可点击展开详情，不拦截下方卡片以外的操作） -->
                        <Popup x:Name="PreviewPopup" AllowsTransparency="True" StaysOpen="True"
                               PlacementTarget="{Binding ElementName=CardRoot}" Placement="Bottom"
                               HorizontalOffset="-6" VerticalOffset="6" PopupAnimation="Fade"
                               Grid.Column="0" Grid.ColumnSpan="6">
                            <Border Background="#EE262B3B" CornerRadius="10" Padding="14,12"
                                    MaxWidth="340" Cursor="Hand"
                                    MouseEnter="PreviewPopup_Enter" MouseLeave="PreviewPopup_Leave"
                                    MouseLeftButtonUp="PreviewPopup_Click">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35" Color="#10131F" />
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="{Binding Text}" Foreground="White" FontSize="13"
                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding PreviewDetails}" Foreground="#C4C9DC"
                                               FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" MaxHeight="132" />
                                    <Border Background="{DynamicResource Card}" CornerRadius="6" Padding="2"
                                            HorizontalAlignment="Left" Margin="0,8,0,0"
                                            Visibility="{Binding FirstImage, Converter={StaticResource NullToCollapsed}}">
                                        <Image Source="{Binding FirstImage}" MaxHeight="130" Stretch="Uniform" />
                                    </Border>
                                    <Border Height="1" Background="#3A3F55" Margin="0,10,0,0" />
                                    <TextBlock Text="{Binding PreviewMeta}" Foreground="#8F96B3"
                                               FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding [ClickToView], Source={x:Static svc:Loc.Instance}}"
                                               Foreground="#9BA3D8" FontSize="10.5"
                                               Margin="0,6,0,0" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- 下拉详情：面板由 IsDetailOpen 控制 -->
                    <StackPanel Grid.Row="1">
                        <Border Background="{DynamicResource Surface2}" CornerRadius="10" Padding="10,9" Margin="0,6,0,2"
                                Cursor="Arrow" MouseLeftButtonUp="InlinePanel_Click"
                                BorderBrush="{DynamicResource Outline}" BorderThickness="1"
                                Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <!-- 面板头 -->
                                <Grid>
                                    <TextBlock Style="{StaticResource DetailLabel}"
                                               Text="{Binding [DetailTitle], Source={x:Static svc:Loc.Instance}}"
                                               VerticalAlignment="Center" />
                                    <Button x:Name="InlinePreviewToggle" Style="{StaticResource GhostBtn}" Content="预览" FontSize="11"
                                            HorizontalAlignment="Right" Click="InlinePreviewToggle_Click"
                                            ToolTip="{Binding [Preview], Source={x:Static svc:Loc.Instance}}" />
                                </Grid>
                                <!-- 详情（编辑 ⇄ 预览切换；Ctrl+V 粘贴图片） -->
                                <Grid Margin="0,8,0,0">
                                    <TextBox x:Name="InlineDetailsBox" Style="{StaticResource InlineDetailBox}" MinHeight="64"
                                             Text="{Binding Details, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                    <StackPanel x:Name="InlinePreviewHost" Visibility="Collapsed" />
                                </Grid>
                                <!-- 标签：流式胶囊 + 行内“＋ 标签”输入 -->
                                <WrapPanel Margin="0,9,0,0">
                                    <ItemsControl ItemsSource="{Binding Tags}" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource Pill}" CornerRadius="5"
                                                        Padding="7,2" Margin="0,0,4,4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding}" FontSize="10.5"
                                                                   Foreground="{DynamicResource TextBody}"
                                                                   VerticalAlignment="Center" />
                                                        <Button Content="✕" FontSize="8.5" Margin="4,0,-2,0"
                                                                Style="{StaticResource GhostBtn}"
                                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                Click="InlineTagRemove_Click" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid Width="74" Margin="0,0,0,4" VerticalAlignment="Center">
                                        <TextBox x:Name="InlineTagBox" FontSize="11.5"
                                                 VerticalContentAlignment="Center"
                                                 KeyDown="InlineTagBox_KeyDown"
                                                 ToolTip="{Binding [TagAddTip], Source={x:Static svc:Loc.Instance}}">
                                            <TextBox.Template>
                                                <ControlTemplate TargetType="TextBox">
                                                    <Border Background="{DynamicResource Card}"
                                                            BorderBrush="{DynamicResource Outline}" BorderThickness="1"
                                                            CornerRadius="6" Padding="6,3">
                                                        <ScrollViewer x:Name="PART_ContentHost"
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                      HorizontalAlignment="Left" />
                                                    </Border>
                                                </ControlTemplate>
                                            </TextBox.Template>
                                        </TextBox>
                                        <TextBlock Text="＋ 标签" IsHitTestVisible="False" FontSize="11"
                                                   Foreground="{DynamicResource TextFaint}"
                                                   VerticalAlignment="Center" Margin="7,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=InlineTagBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </WrapPanel>


                                <!-- 优先级 -->
                                <Border Background="{DynamicResource Pill}" CornerRadius="9" Padding="3"
                                        HorizontalAlignment="Left" Margin="0,9,0,0">
                                    <UniformGrid Columns="4">
                                        <RadioButton Style="{StaticResource SegButton}" GroupName="{Binding Id}"
                                                     Content="{Binding [PriorityNone], Source={x:Static svc:Loc.Instance}}"
                                                     IsChecked="{Binding Priority, Mode=TwoWay, Converter={StaticResource PriorityEquals}, ConverterParameter=0}" />
                                        <RadioButton Style="{StaticResource SegButton}" GroupName="{Binding Id}"
                                                     Content="{Binding [PriorityLow], Source={x:Static svc:Loc.Instance}}"
                                                     IsChecked="{Binding Priority, Mode=TwoWay, Converter={StaticResource PriorityEquals}, ConverterParameter=1}" />
                                        <RadioButton Style="{StaticResource SegButton}" GroupName="{Binding Id}"
                                                     Content="{Binding [PriorityMid], Source={x:Static svc:Loc.Instance}}"
                                                     IsChecked="{Binding Priority, Mode=TwoWay, Converter={StaticResource PriorityEquals}, ConverterParameter=2}" />
                                        <RadioButton Style="{StaticResource SegButton}" GroupName="{Binding Id}"
                                                     Content="{Binding [PriorityHigh], Source={x:Static svc:Loc.Instance}}"
                                                     IsChecked="{Binding Priority, Mode=TwoWay, Converter={StaticResource PriorityEquals}, ConverterParameter=3}" />
                                    </UniformGrid>
                                </Border>

                                <!-- 操作行 -->
                                <Grid Margin="0,10,0,0">
                                    <Button Style="{StaticResource GhostBtn}"
                                            Content="{Binding [Delete], Source={x:Static svc:Loc.Instance}}"
                                            HorizontalAlignment="Left" VerticalAlignment="Center" Click="InlineDelete_Click" />
                                    <Button Style="{StaticResource AddBtn}"
                                            Content="{Binding [Done], Source={x:Static svc:Loc.Instance}}"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" Click="InlineDone_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 子任务（完整卡片，递归模板） -->
                        <ItemsControl ItemsSource="{Binding Children}"
                                      ItemTemplate="{DynamicResource TodoCard}"
                                      Margin="2,2,0,0"
                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ======== 标题栏 ======== -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <Border Width="24" Height="24" CornerRadius="7" Background="{DynamicResource Accent}">
                    <TextBlock Text="✓" Foreground="White" FontSize="13" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="AppTitleTb" Text="JeffBox" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBody}"
                           Margin="9,0,0,0" VerticalAlignment="Center" />
                <Border x:Name="HotkeyPill" CornerRadius="5" Background="{DynamicResource Pill}"
                        Padding="7,2" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock x:Name="HotkeyPillText" Text="Ctrl+Alt+T"
                               FontSize="10.5" Foreground="{DynamicResource TextSub}" />
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,8,0">
                <Button x:Name="SettingsBtn" Style="{StaticResource CaptionBtn}"
                        ToolTip="设置" Click="SettingsBtn_Click">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE713;" FontSize="12" />
                </Button>
                <Button Style="{StaticResource CaptionBtn}" Content="—"
                        x:Name="MinBtn" Click="MinBtn_Click" />
                <Button x:Name="MaxBtn" Style="{StaticResource CaptionBtn}"
                        ToolTip="最大化 / 还原" Click="MaxBtn_Click">
                    <TextBlock x:Name="MaxBtnIcon" FontFamily="{StaticResource IconFont}"
                               Text="&#xE922;" FontSize="11" />
                </Button>
                <Button x:Name="WinCloseBtn" Style="{StaticResource CloseBtn}" Content="✕"
                        ToolTip="关闭" Click="CloseBtn_Click" />
            </StackPanel>
        </Grid>

        <!-- ======== 主内容区 ======== -->
        <Grid Grid.Row="1">
        <Grid x:Name="TodoView">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ======== 页眉 ======== -->
        <StackPanel Grid.Row="0" Margin="24,10,24,14">
            <TextBlock x:Name="HeaderTitleTb" Text="今日待办" FontSize="24" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextMain}" />
            <TextBlock x:Name="DateText" FontSize="12.5"
                       Foreground="{DynamicResource TextSub}" Margin="1,5,0,0" />
        </StackPanel>

        <!-- ======== 输入区（标题 + 可展开详情） ======== -->
        <StackPanel Grid.Row="1" Margin="20,0,20,14">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="PriorityBtn" Style="{StaticResource PriorityBtn}" VerticalAlignment="Center"
                        Click="PriorityBtn_Click">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="PriorityDot" Width="9" Height="9" Fill="#C9CEE0" />
                        <TextBlock x:Name="PriorityLabel" Text="无" Margin="6,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Grid Grid.Column="2">
                    <TextBox x:Name="InputBox" Style="{StaticResource MainInput}"
                             KeyDown="InputBox_KeyDown" VerticalAlignment="Center" />
                    <TextBlock x:Name="InputHintTb" Text="想做点什么？按 Enter 快速添加"
                               Foreground="{DynamicResource TextFaint}" FontSize="13"
                               IsHitTestVisible="False" VerticalAlignment="Center"
                               Margin="12,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=InputBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Button Grid.Column="4" x:Name="DetailsToggleBtn" Style="{StaticResource ChipBtn}"
                        Content="更多" Click="DetailsToggleBtn_Click" VerticalAlignment="Center" />

                <Button Grid.Column="6" x:Name="AddBtn" Style="{StaticResource AddBtn}"
                        Content="添加" Click="AddBtn_Click" VerticalAlignment="Center" />
            </Grid>

            <!-- 完整创建卡：与详情浮层同构，一步创建 -->
            <Border x:Name="NewDetailsPanel" Visibility="Collapsed" Background="{DynamicResource Card}"
                    BorderBrush="{DynamicResource Outline}" BorderThickness="1"
                    CornerRadius="12" Padding="12,10" Margin="0,0,0,2"
                    MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270"
                                      Opacity="0.08" Color="#3A4160" />
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid>
                        <TextBlock x:Name="NewDetailsLabelTb" Style="{StaticResource DetailLabel}"
                                   Margin="2,0,0,6" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="NewInsertImageBtn" Style="{StaticResource ChipBtn}"
                                    Content="插入图片" Click="NewInsertImageBtn_Click" Margin="0,0,6,0" />
                            <Button x:Name="NewPreviewBtn" Style="{StaticResource ChipBtn}"
                                    Content="预览" Click="NewPreviewBtn_Click" />
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid x:Name="NewEditArea">
                            <TextBox x:Name="NewDetailsBox" Style="{StaticResource NewDetailsBox}"
                                     KeyDown="NewDetailsBox_KeyDown" PreviewKeyDown="NotesBox_PreviewKeyDown" />
                            <TextBlock x:Name="NewDetailsHint" Text="添加详细内容（可选，支持 Markdown，可直接粘贴图片）"
                                       Foreground="{DynamicResource TextFaint}" FontSize="12"
                                       IsHitTestVisible="False" Margin="11,10,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=NewDetailsBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Border x:Name="NewPreviewHost" Visibility="Collapsed"
                                Background="{DynamicResource Surface2}" CornerRadius="9" Padding="10,8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="140">
                                <StackPanel x:Name="NewPreviewPanel" />
                            </ScrollViewer>
                        </Border>
                    </Grid>


                    <!-- 标签（流式胶囊 + “＋ 标签”输入） -->
                    <WrapPanel Margin="0,9,0,0">
                        <ItemsControl x:Name="NewTagList" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Pill}" CornerRadius="5"
                                            Padding="7,2" Margin="0,0,4,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding}" FontSize="10.5"
                                                       Foreground="{DynamicResource TextBody}"
                                                       VerticalAlignment="Center" />
                                            <Button Content="✕" FontSize="8.5" Margin="4,0,-2,0"
                                                    Style="{StaticResource GhostBtn}"
                                                    Click="NewTagRemove_Click" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Width="74" Margin="0,0,0,4" VerticalAlignment="Center">
                            <TextBox x:Name="NewTagBox" FontSize="11.5"
                                     VerticalContentAlignment="Center"
                                     KeyDown="NewTagBox_KeyDown"
                                     ToolTip="{Binding [TagAddTip], Source={x:Static svc:Loc.Instance}}">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border Background="{DynamicResource Card}"
                                                BorderBrush="{DynamicResource Outline}" BorderThickness="1"
                                                CornerRadius="6" Padding="6,3">
                                            <ScrollViewer x:Name="PART_ContentHost"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                          HorizontalAlignment="Left" />
                                        </Border>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                            <TextBlock Text="＋ 标签" IsHitTestVisible="False" FontSize="11"
                                       Foreground="{DynamicResource TextFaint}"
                                       VerticalAlignment="Center" Margin="7,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=NewTagBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </WrapPanel>

                    <TextBlock x:Name="NewPriorityLabelTb" Style="{StaticResource DetailLabel}" />
                    <Border Background="{DynamicResource Pill}" CornerRadius="9" Padding="3"
                            HorizontalAlignment="Left">
                        <UniformGrid Columns="4">
                            <RadioButton x:Name="NewP0" Style="{StaticResource SegButton}"
                                         GroupName="newPriority" Checked="NewP_Checked" />
                            <RadioButton x:Name="NewP1" Style="{StaticResource SegButton}"
                                         GroupName="newPriority" Checked="NewP_Checked" />
                            <RadioButton x:Name="NewP2" Style="{StaticResource SegButton}"
                                         GroupName="newPriority" Checked="NewP_Checked" />
                            <RadioButton x:Name="NewP3" Style="{StaticResource SegButton}"
                                         GroupName="newPriority" Checked="NewP_Checked" />
                        </UniformGrid>
                    </Border>

                </StackPanel>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <!-- ======== 筛选器 + 一键展开/收起 ======== -->
        <Grid Grid.Row="2" Margin="20,0,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource Pill}"
                    CornerRadius="10" Padding="3">
                <UniformGrid Columns="3">
                    <RadioButton x:Name="FilterAll" Style="{StaticResource SegButton}" GroupName="filter"
                                 IsChecked="True" Content="全部" Checked="Filter_Checked" />
                    <RadioButton x:Name="FilterActive" Style="{StaticResource SegButton}" GroupName="filter"
                                 Content="待办" Checked="Filter_Checked" />
                    <RadioButton x:Name="FilterDone" Style="{StaticResource SegButton}" GroupName="filter"
                                 Content="已完成" Checked="Filter_Checked" />
                </UniformGrid>
            </Border>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="ToggleAllBtn" Style="{StaticResource ChipBtn}"
                        Content="全部收起" Click="ToggleAllBtn_Click" Visibility="Collapsed"
                        VerticalAlignment="Stretch" />
            </StackPanel>
        </Grid>

        <!-- ======== 列表 ======== -->
        <Grid Grid.Row="3" Margin="20,0,20,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ListItems" ItemTemplate="{StaticResource TodoCard}"
                          ScrollViewer.CanContentScroll="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0">
                <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource Card}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Direction="270"
                                          Opacity="0.10" Color="#3A4160" />
                    </Border.Effect>
                    <TextBlock Text="✓" FontSize="34" Foreground="#B9C3F5"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="EmptyTitleTb" Text="这里空空如也" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSub}" HorizontalAlignment="Center" Margin="0,16,0,0" />
                <TextBlock x:Name="EmptyHintTb" Text="在上方输入一条待办，开始规划今天" FontSize="12"
                           Foreground="{DynamicResource TextFaint}"
                           HorizontalAlignment="Center" Margin="0,5,0,0" />
                <TextBlock x:Name="EmptyHint2Tb" Text="单击卡片可展开详情、标签与子任务" FontSize="11"
                           Foreground="{DynamicResource TextFaint}"
                           HorizontalAlignment="Center" Margin="0,3,0,0" />
            </StackPanel>
        </Grid>

        <!-- ======== 底栏 ======== -->
        <StackPanel Grid.Row="4" Margin="20,14,20,16">
            <ProgressBar x:Name="DoneBar" Style="{StaticResource SlimProgress}"
                         Minimum="0" Maximum="100" Value="0" />
            <Grid Margin="2,9,2,0">
                <TextBlock x:Name="DoneText" Text="已完成 0 / 0" FontSize="12"
                           Foreground="{DynamicResource TextSub}" VerticalAlignment="Center" />
                <Button x:Name="ClearDoneBtn" Style="{StaticResource GhostBtn}" VerticalAlignment="Center"
                        Content="清除已完成" HorizontalAlignment="Right"
                        Visibility="Collapsed" Click="ClearDoneBtn_Click" />
            </Grid>
        </StackPanel>

        </Grid><!-- /TodoView -->

        </Grid><!-- /主内容区 -->

        <!-- ======== 详情浮层（实时编辑，任意层级） ======== -->

        <!-- ======== 设置浮层 ======== -->
        <Grid x:Name="SettingsOverlay" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed">
            <Border x:Name="SettingsMask" Background="#73161C2E" Opacity="0"
                    MouseLeftButtonUp="SettingsMask_MouseLeftButtonUp" />
            <Border x:Name="SettingsCard" Width="360" CornerRadius="16" Background="{DynamicResource Card}"
                    BorderBrush="{DynamicResource Outline}" BorderThickness="1"
                    Padding="22,18" Margin="0,16" VerticalAlignment="Center" HorizontalAlignment="Center"
                    MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                    Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="SettingsScale" ScaleX="0.96" ScaleY="0.96" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.30" Color="#1A2038" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- 标题与关闭按钮固定在滚动区外：无论滚到哪里都可见，也不会被滚动条压住 -->
                    <Grid Grid.Row="0" Margin="0,0,8,10">
                        <TextBlock x:Name="SettingsTitleTb" Text="设置" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMain}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource GhostBtn}" Content="✕" FontSize="11"
                                HorizontalAlignment="Right" Click="SettingsCloseBtn_Click" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" MaxHeight="556" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <!-- 右侧 8px 让位给覆盖式滚动条，滑块不压「停用」等按钮 -->
                        <StackPanel Margin="0,0,8,0">
                    <TextBlock x:Name="LangLabelTb" Style="{StaticResource SettingsLabel}" Text="语言" />
                    <Border Background="{DynamicResource Pill}" CornerRadius="9" Padding="3"
                            HorizontalAlignment="Left">
                        <UniformGrid Columns="2">
                            <RadioButton x:Name="LangZh" Style="{StaticResource SegButton}"
                                         GroupName="setLang" Content="简体中文" Checked="LangZh_Checked" />
                            <RadioButton x:Name="LangEn" Style="{StaticResource SegButton}"
                                         GroupName="setLang" Content="English" Checked="LangEn_Checked" />
                        </UniformGrid>
                    </Border>

                    <TextBlock x:Name="ThemeLabelTb" Style="{StaticResource SettingsLabel}" Text="外观" />
                    <Border Background="{DynamicResource Pill}" CornerRadius="9" Padding="3"
                            HorizontalAlignment="Left">
                        <UniformGrid Columns="2">
                            <RadioButton x:Name="SetThemeLight" Style="{StaticResource SegButton}"
                                         GroupName="setTheme" Content="浅色" Checked="SetThemeLight_Checked" />
                            <RadioButton x:Name="SetThemeDark" Style="{StaticResource SegButton}"
                                         GroupName="setTheme" Content="深色" Checked="SetThemeDark_Checked" />
                        </UniformGrid>
                    </Border>

                    <TextBlock x:Name="CloseBehaviorLabelTb" Style="{StaticResource SettingsLabel}" Text="关闭方式" />
                    <Border Background="{DynamicResource Pill}" CornerRadius="9" Padding="3"
                            HorizontalAlignment="Left">
                        <UniformGrid Columns="2">
                            <RadioButton x:Name="CloseTrayRadio" Style="{StaticResource SegButton}"
                                         GroupName="setClose" Content="最小化到托盘" Checked="CloseTrayRadio_Checked" />
                            <RadioButton x:Name="CloseExitRadio" Style="{StaticResource SegButton}"
                                         GroupName="setClose" Content="直接退出" Checked="CloseExitRadio_Checked" />
                        </UniformGrid>
                    </Border>

                    <TextBlock x:Name="AutoStartLabelTb" Style="{StaticResource SettingsLabel}" Text="开机自启动" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="AutoStartToggle" Grid.Column="0"
                                  Style="{StaticResource SwitchCheck}" VerticalAlignment="Center"
                                  Checked="AutoStartToggle_Changed" Unchecked="AutoStartToggle_Changed" />
                        <TextBlock x:Name="AutoStartHintTb" Grid.Column="2" Text="开机后自动在系统托盘静默运行"
                                   FontSize="11.5" Foreground="{DynamicResource TextSub}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                    </Grid>

                    <TextBlock x:Name="OpenPosLabelTb" Style="{StaticResource SettingsLabel}" Text="打开位置" />
                    <ComboBox x:Name="OpenPosCombo" Width="196"
                              HorizontalAlignment="Left" SelectionChanged="OpenPosCombo_SelectionChanged" />

                    <TextBlock x:Name="HotkeyLabelTb" Style="{StaticResource SettingsLabel}" Text="全局快捷键" />
                    <StackPanel>
                        <views:HotkeyBox x:Name="HkMain" />
                        <views:HotkeyBox x:Name="HkTodo" Margin="0,8,0,0" />
                    </StackPanel>

                    <TextBlock x:Name="BackupLabelTb" Style="{StaticResource SettingsLabel}" Text="数据备份" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BackupExportBtn" Style="{StaticResource ChipBtn}"
                                Content="导出备份" Click="BackupExportBtn_Click" Margin="0,0,8,0" />
                        <Button x:Name="BackupImportBtn" Style="{StaticResource ChipBtn}"
                                Content="导入恢复" Click="BackupImportBtn_Click" />
                    </StackPanel>
                    <TextBlock x:Name="BackupHintTb" FontSize="11" Margin="2,6,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFaint}" />

                    <Border Height="1" Background="{DynamicResource Line}" Margin="0,16,0,12" />
                    <TextBlock x:Name="SettingsAboutTb" Text="JeffBox v1.0.0 · 数据仅保存在本机"
                               FontSize="11" Foreground="{DynamicResource TextFaint}" />
                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
